<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
    <style>
        :root { font-family: 'Cairo', sans-serif !important; --bs-font-sans-serif: 'Cairo', sans-serif; --bs-body-font-family: 'Cairo', sans-serif; color: #273142; background: #f3f4f6; direction: rtl; }
        * { box-sizing: border-box; } html, body { font-family: 'Cairo', sans-serif !important; margin: 0; min-height: 100%; background: #f3f4f6; } button, input, select { font: inherit; } button { cursor: pointer; }
        .app-shell { min-height: 100vh; padding-bottom: 98px; } .topbar { height: 56px; padding: 0 4%; display: flex; align-items: center; justify-content: space-between; background: #17253a; color: #fff; } .brand { font-weight: 700; font-size: 16px; } .breadcrumb { font-size: 12px; color: #dbe5f4; } .breadcrumb span { margin: 0 8px; color: #8fa4c0; }
        .page-container { width: min(1392px, 92%); margin: 0 auto; padding: 16px 0 28px; } .card { background: #fff; border: 1px solid #e4e7ec; border-radius: 14px; box-shadow: 0 2px 9px rgba(20,32,50,.06); margin-bottom: 10px; overflow: hidden; } .card-heading { min-height: 46px; padding: 0 20px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #edf0f4; } .card-heading h2 { margin: 0; font-size: 14px; font-weight: 600; color: #263449; } .card-heading h2 span { font-weight: 400; color: #5e6877; } .tag { padding: 3px 9px; border-radius: 99px; background: #f1f4f7; color: #7b8797; font-size: 10px; white-space: nowrap; }
        .header-grid { padding: 22px 20px 18px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; } .add-grid { padding: 22px 20px 18px; display: grid; grid-template-columns: 1.3fr 1.3fr .9fr .9fr 1.1fr auto; gap: 12px; align-items: end; } .field { display: flex; flex-direction: column; gap: 6px; min-width: 0; color: #596575; font-size: 11px; font-weight: 600; } .field.required > span::after { content: ' *'; color: #c73638; } .field em { color: #8b94a0; font-style: normal; font-weight: 400; } .field input, .field select, .editing-row input, .editing-row select { width: 100%; height: 40px; padding: 0 11px; border: 1px solid #d6dae1; border-radius: 7px; background: #fff; color: #273142; outline: none; font-size: 12px; } .field input:focus, .field select:focus, .editing-row input:focus, .editing-row select:focus { border-color: #2a5bd7; box-shadow: 0 0 0 3px rgba(42,91,215,.15); }
        .field input.invalid { border-color: #d33c3c; background: #fff8f8; } .inline-error { color: #c73638; font-size: 10px; font-weight: 500; } .primary, .secondary, .danger-button { border: 0; border-radius: 7px; height: 40px; padding: 0 20px; font-weight: 600; font-size: 12px; } .primary { background: #2859d4; color: #fff; box-shadow: 0 4px 8px rgba(40,89,212,.16); } .primary:disabled { background: #aeb7c5; box-shadow: none; cursor: not-allowed; } .add-button { min-width: 90px; }
        .table-wrap { overflow-x: auto; padding: 14px 20px 20px; } table { width: 100%; border-collapse: separate; border-spacing: 0; min-width: 760px; font-size: 12px; border: 1px solid #dce1e8; border-radius: 8px; overflow: hidden; } th { height: 42px; padding: 0 12px; background: #f8fafc; border-bottom: 1px solid #dce1e8; border-left: 1px solid #dce1e8; color: #445063; font-weight: 700; white-space: nowrap; } td { height: 48px; padding: 0 12px; border-bottom: 1px solid #edf0f3; border-left: 1px solid #edf0f3; color: #4a5566; white-space: nowrap; } th:last-child, td:last-child { border-left: none; } tr:last-child td { border-bottom: none; } tbody tr:not(.editing-row):hover { background: #fafbfe; } .number { direction: ltr; text-align: center; font-variant-numeric: tabular-nums; } .actions { text-align: center; } .link-action { display: inline-flex; align-items: center; justify-content: center; gap: 4px; padding: 6px 10px; border: 1px solid transparent; background: #f8fafc; border-radius: 6px; color: #2859d4; font-size: 11px; font-weight: 600; transition: all 0.2s ease; cursor: pointer; margin: 0 2px; } .link-action.icon-only { width: 30px; height: 30px; padding: 0; border-radius: 8px; } .link-action.icon-only i { font-size: 16px; margin: 0; } .link-action i { font-size: 14px; } .link-action:hover { background: #eff4ff; border-color: #d1e0ff; transform: translateY(-1px); box-shadow: 0 2px 4px rgba(40,89,212,.08); } .link-action:active { transform: translateY(0); } .link-action.danger { color: #c73638; background: #fff5f5; } .link-action.danger:hover { background: #fee2e2; border-color: #fca5a5; box-shadow: 0 2px 4px rgba(199,54,56,.08); } .link-action.muted { color: #687385; background: #f1f5f9; } .link-action.muted:hover { background: #e2e8f0; border-color: #cbd5e1; color: #475569; } .editing-row { background: #fff9e9; } .editing-row input, .editing-row select { height: 34px; min-width: 92px; font-size: 11px; text-align: center; }
        .empty-state { min-height: 142px; margin: 10px 0; border: 1px dashed #d5dce5; border-radius: 11px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; color: #697587; } .empty-state strong { font-size: 13px; color: #5d6878; } .empty-state span { font-size: 11px; } .empty-state small { color: #8d98a7; font-size: 10px; } .empty-icon { font-size: 24px; opacity: .7; } .global-message { height: 44px; margin-bottom: 10px; padding: 0 16px; display: flex; align-items: center; gap: 9px; border-bottom: 2px solid; border-radius: 7px; font-size: 12px; font-weight: 600; } .global-message.success { background: #f0fdf4; border-color: #53b878; color: #267442; } .global-message.error { background: #fef2f2; border-color: #d95555; color: #a52d2d; } .message-icon { width: 21px; height: 21px; display: grid; place-items: center; border-radius: 50%; color: #fff; font-size: 11px; } .success .message-icon { background: #43aa69; } .error .message-icon { background: #d84c4c; }
        .loading-card { padding: 26px; background: #fff; border-radius: 12px; text-align: center; color: #657286; font-size: 13px; } .save-bar { position: fixed; z-index: 10; bottom: 0; left: 0; right: 0; min-height: 76px; padding: 0 4%; background: #fff; box-shadow: 0 -3px 13px rgba(20,32,50,.12); } .save-bar-inner { width: 100%; height: 76px; display: flex; align-items: center; justify-content: center; gap: 24px; } .save-bar-note { display: flex; align-items: center; gap: 6px; color: #7b8491; font-size: 11px; white-space: nowrap; } .save-button { width: 200px; height: 44px; font-size: 13px; } .modal-backdrop { position: fixed; z-index: 20; inset: 0; display: grid; place-items: center; padding: 20px; background: rgba(0,0,0,.45); } .confirm-dialog { width: min(460px, 100%); padding: 23px; border-radius: 14px; background: #fff; box-shadow: 0 18px 55px rgba(0,0,0,.22); } .dialog-title { display: flex; align-items: center; gap: 8px; font-weight: 700; color: #293548; font-size: 14px; } .dialog-title small { color: #7a8595; font-weight: 400; } .danger-dot { width: 9px; height: 9px; border-radius: 50%; background: #d44b4b; } .confirm-dialog p { margin: 22px 0 10px; font-size: 13px; color: #3f4b5d; } .dialog-detail { padding: 12px; border-radius: 7px; background: #f5f6f8; color: #667284; font-size: 11px; } .dialog-actions { display: flex; justify-content: flex-start; gap: 10px; margin-top: 22px; } .danger-button { background: #d34848; color: #fff; } .secondary { border: 1px solid #bfc9d8; background: #fff; color: #3452a0; }
        @@media (max-width: 1100px) { .header-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .add-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .add-button { justify-self: start; } }
        @@media (max-width: 640px) { .topbar { height: auto; min-height: 62px; padding: 9px 16px; align-items: flex-start; flex-direction: column; gap: 3px; } .page-container { width: 94%; padding-top: 10px; } .header-grid, .add-grid { grid-template-columns: 1fr; padding: 16px 14px; gap: 12px; } .card-heading { padding: 0 14px; gap: 8px; } .card-heading h2 { font-size: 12px; } .tag { max-width: 130px; white-space: normal; text-align: center; } .table-wrap { padding: 10px 10px 14px; } .save-bar { padding: 10px 3%; flex-direction: column-reverse; align-items: stretch; gap: 6px; } .save-button { width: 100%; } .save-bar > span { text-align: center; font-size: 9px; } }
    </style>
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
